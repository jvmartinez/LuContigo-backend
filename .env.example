NODE_ENV=development
PORT=3000
# Puertos del host para docker compose (5432/6379 suelen estar ocupados por instalaciones locales)
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://medicita:medicita@localhost:5433/medicita
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=cambiar
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambiar
JWT_REFRESH_TTL=7d
CONFIRMACION_TOKEN_SECRET=cambiar
APP_WEB_URL=http://localhost:5173
# resend | consola (consola simula el envío; útil en desarrollo)
EMAIL_PROVIDER=consola
EMAIL_API_KEY=
# El proveedor Resend debe autorizar/verificar esta dirección como remitente.
EMAIL_FROM="MediCita <develper.jvmartinez@gmail.com>"
# twilio | consola
SMS_PROVIDER=consola
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=recordatorio_cita
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=      # credencial de servicio en base64
CORS_ORIGINS=http://localhost:5173
