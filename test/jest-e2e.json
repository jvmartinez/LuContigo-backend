{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "<rootDir>/jest-esm.js"
  },
  "transformIgnorePatterns": ["/node_modules/(?!@nestjs/)"],
  "testTimeout": 180000
}
